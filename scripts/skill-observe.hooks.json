{
  "description": "skill 观测（机制层）：捕获原始事件行到 skill-事件日志.jsonl。判断归 skill-iteration-review，见 references/harness.md。安装：复制到 ~/.codex/hooks.json 后，在 CLI 用 /hooks 审查并信任。",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/chess/workspace/skills/scripts/skill-observe.py",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/chess/workspace/skills/scripts/skill-observe.py",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/chess/workspace/skills/scripts/skill-observe.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/chess/workspace/skills/scripts/skill-observe.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/chess/workspace/skills/scripts/skill-observe.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
